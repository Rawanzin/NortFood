/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=()
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https://*.supabase.co https://tile.openstreetmap.org https://*.tile.openstreetmap.org; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://nominatim.openstreetmap.org; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
/sw.js
  Content-Type: application/javascript; charset=UTF-8
  Cache-Control: no-cache

/config.js
  Cache-Control: no-store

/index.html
  Cache-Control: no-cache

/site.webmanifest
  Content-Type: application/manifest+json; charset=UTF-8
  Cache-Control: no-cache

/manifest.webmanifest
  Content-Type: application/manifest+json; charset=UTF-8
  Cache-Control: no-cache

/
  Cache-Control: no-cache

/app.js
  Cache-Control: public, max-age=0, must-revalidate

/pwa.js
  Cache-Control: public, max-age=0, must-revalidate

/styles.css
  Cache-Control: public, max-age=0, must-revalidate

/refinements.css
  Cache-Control: public, max-age=0, must-revalidate

/pwa.css
  Cache-Control: public, max-age=0, must-revalidate

/assets/*
  Cache-Control: public, max-age=0, must-revalidate

/assets/optimized/*
  Cache-Control: public, max-age=86400, must-revalidate

/assets/fonts/*
  Cache-Control: public, max-age=604800, must-revalidate

/release.json
  Cache-Control: no-store
