# Copiar para .env.homologacao na raiz (ignorado pelo Git).
# Nunca copiar chaves, usuarios ou dados do projeto principal.
NORTFOOD_TEST_SUPABASE_URL=
NORTFOOD_TEST_SUPABASE_PUBLISHABLE_KEY=
# Somente Node/painel seguro; nunca no frontend ou em mensagens.
NORTFOOD_TEST_SUPABASE_SERVICE_ROLE_KEY=
NORTFOOD_TEST_ADMIN_EMAIL=
NORTFOOD_TEST_ADMIN_PASSWORD=
# yes apenas para um projeto separado e descartavel identificado pelo responsavel.
NORTFOOD_TEST_CONFIRM_DISPOSABLE=no
