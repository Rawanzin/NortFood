# PUBLICAS: podem compor o navegador. Nunca colocar service_role aqui.
# Project URL raiz, por exemplo https://<project-ref>.supabase.co (sem /rest/v1).
NORTFOOD_SUPABASE_URL=
NORTFOOD_SUPABASE_PUBLISHABLE_KEY=
NORTFOOD_APP_URL=http://localhost:4173
# Somente apos definir origem HTTPS real e autorizar indexacao publica:
NORTFOOD_ENABLE_INDEXING=no
# Publicação institucional segura enquanto loja, e-mail e operação aguardam homologação.
NORTFOOD_PUBLIC_PREVIEW=yes
# GA4 opcional. Sem ID nao carrega tags nem envia estatisticas.
NORTFOOD_GA4_MEASUREMENT_ID=
# Confirmar no painel GA4 que Enhanced Measurement / historico automatico foi desativado:
NORTFOOD_GA4_AUTOMATIC_MEASUREMENT_DISABLED=no
# Para Supabase local; na nuvem, atualizar tambem a allowlist no painel Auth.
NORTFOOD_AUTH_REDIRECT_URL=http://localhost:4173/
# Antes de publicar, definir dominio HTTPS real; build nao configura o painel.
# Somente para o teste live, ambiente de testes descartável, nunca no build:
# Referencia protegida, mesmo se o frontend for apontado para homologacao.
NORTFOOD_PRODUCTION_SUPABASE_URL=https://zwkhqahivthzivmuirjr.supabase.co
NORTFOOD_TEST_SUPABASE_URL=
NORTFOOD_TEST_SUPABASE_SERVICE_ROLE_KEY=

NORTFOOD_TEST_SUPABASE_PUBLISHABLE_KEY=
NORTFOOD_TEST_ADMIN_EMAIL=
NORTFOOD_TEST_ADMIN_PASSWORD=
NORTFOOD_TEST_CONFIRM_DISPOSABLE=no
